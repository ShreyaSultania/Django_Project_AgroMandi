# Server Port (default 5001)
PORT=5001

# Django Settings
DEBUG=True
SECRET_KEY=your-django-secret-key-here
ALLOWED_HOSTS=*

# External Services & APIs
# OpenCage Geocoding API Key (optional - fallback to Nominatim & local coordinates)
OPENCAGE_API_KEY=your_opencage_api_key_here

# OpenWeatherMap API Key (optional - fallback to default weather estimation)
WEATHER_API_KEY=your_openweather_api_key_here

# data.gov.in Agmarknet API Key (optional - fallback to 9ef84268-d588-465a-a308-a864a43d0070.csv dataset)
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# Redis URI for caching market prices (optional)
# REDIS_URI=redis://localhost:6379
